      "equations": [
        {"lhs": "t_utc", "rhs": {"op": "+", "args": ["t", "t_ref"]}},
        {"lhs": "DOY", "rhs": {"op": "fn", "name": "datetime.day_of_year", "args": ["t_utc"]}},
        {
          "lhs": "utc_hours",
          "rhs": {
            "op": "+",
            "args": [
              {"op": "fn", "name": "datetime.hour", "args": ["t_utc"]},
              {"op": "/", "args": [{"op": "fn", "name": "datetime.minute", "args": ["t_utc"]}, 60.0]},
              {"op": "/", "args": [{"op": "fn", "name": "datetime.second", "args": ["t_utc"]}, 3600.0]}
            ]
          }
        },
        {"lhs": "year", "rhs": {"op": "fn", "name": "datetime.year", "args": ["t_utc"]}},
        {
          "lhs": "yearday_temp",
          "rhs": {
            "op": "*",
            "args": [
              6.283185307179586,
              {
                "op": "+",
                "args": [
                  {"op": "-", "args": ["DOY", 1.0]},
                  {"op": "/", "args": [{"op": "-", "args": ["utc_hours", 12.0]}, 24.0]}
                ]
              }
            ]
          }
        },
        {
          "lhs": "gamma",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "==",
                "args": [
                  {
                    "op": "-",
                    "args": ["year", {"op": "*", "args": [4.0, {"op": "floor", "args": [{"op": "/", "args": ["year", 4.0]}]}]}]
                  },
                  0.0
