      "analyses": [
        {
          "id": "diurnal_cycle",
          "description": "Photolysis rates through 1 May 2016 at 40N, 97W, at the surface, one point per UTC hour (t_ref = 2016-05-01T00Z + h hours): upstream's solar geometry sets cosSZA from t + t_ref, so the rates peak near 18Z (local solar noon) and fall to the twilight diffuse floor, then zero, at night.",
          "parameters": {"lat": 40.0, "long": -97.0, "T": 298.0, "P": 101325.0, "H2O": 10000000.0},
          "time_span": {"start": 0.0, "end": 1.0},
          "parameter_sweep": {
            "type": "cartesian",
            "dimensions": [
              {
                "parameter": "t_ref",
                "values": [1462060800.0, 1462064400.0, 1462068000.0, 1462071600.0, 1462075200.0, 1462078800.0, 1462082400.0, 1462086000.0, 1462089600.0, 1462093200.0, 1462096800.0, 1462100400.0, 1462104000.0, 1462107600.0, 1462111200.0, 1462114800.0, 1462118400.0, 1462122000.0, 1462125600.0, 1462129200.0, 1462132800.0, 1462136400.0, 1462140000.0, 1462143600.0, 1462147200.0]
              }
            ]
