        "tau_187": {
          "type": "unknown",
          "units": "1",
          "description": "Slant optical depth in band 1 (187 nm): 0.5*sum_i OD_total[div(i+1,2), 1]*amf_i over upstream's fixed climatological column (Rayleigh + O2 + O3 absorption)."
        },
        "Fdir_187": {
          "type": "unknown",
          "units": "1/s",
          "description": "Direct-beam actinic flux in band 1 (upstream calc_direct_flux): top_flux*exp(-tau) (0 in shadow or for tau >= 76; the bare TOA flux for P < 1 Pa)."
        },
        "Fdif_187": {
          "type": "unknown",
          "units": "1/s",
          "description": "Clear-sky diffuse actinic flux in band 1: bilinear (P, cosSZA) lookup of upstream's precomputed Cloud-J Feautrier field (diffuse_flux_data.bson; Rayleigh multiple scattering, albedo 0.10, AOD 0; flat outside 1000-100000 Pa x -0.2..1.0)."
        },
        "F_187": {
          "type": "unknown",
          "units": "1/s",
          "description": "Actinic flux in band 1 (187 nm) = (direct + diffuse)*solf (upstream flux_sys_scattering)."
        },
        "tau_191": {
