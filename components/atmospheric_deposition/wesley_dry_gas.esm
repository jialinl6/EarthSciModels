      ],
      "tests": [
        {
          "id": "defaults_mixedforest",
          "description": "season 1, land use mixedforest 1; z = 60.0 m, z0 = 0.04 m, u* = 0.44 m/s, L = 0.0 m, G = 300.0 W/m2, Ts = 298.0 K, theta = 0.0, lev = 1. Expected values are upstream's DryDepGasFractional at these inputs (jialinl6/DepositionMTK.jl@cbe7d7db (branch superfast-gas-only)).",
          "parameter_overrides": {
            "f_mixedforest": 1.0,
            "Ts": 298.0,
            "f_water": 0.0,
            "L": 0.0,
            "f_barren": 0.0,
            "f_agricultural": 0.0,
            "theta": 0.0,
            "f_wetland": 0.0,
            "f_deciduous": 0.0,
            "z": 60.0,
            "season": 1,
            "f_rockyshrubs": 0.0,
            "f_range": 0.0,
            "rho_A": 1.2,
            "z0": 0.04,
            "f_coniferous": 0.0,
            "G": 300.0,
            "f_rangeag": 0.0,
            "del_P": 1520.0,
            "lev": 1,
            "f_urban": 0.0,
            "u_star": 0.44
          },
          "time_span": {"start": 0.0, "end": 1.0},
          "assertions": [
            {"variable": "v_O3", "time": 0.0, "expected": 0.004334598201322247},
            {"variable": "v_NO2", "time": 0.0, "expected": 0.0035813270396316925},
