      "analyses": [
        {
          "id": "season_sweep",
          "description": "O3, HNO3 and CH2O deposition velocity by Wesely season over a Midwest-like mosaic (55% agricultural, 20% range/agricultural, 10% deciduous, 10% urban, 5% water) at noon-like conditions: stomatal and canopy uptake fall from midsummer to winter.",
          "parameters": {
            "f_mixedforest": 0.0,
            "f_agricultural": 0.55,
            "f_rangeag": 0.2,
            "f_deciduous": 0.1,
            "f_urban": 0.1,
            "f_water": 0.05,
            "G": 600.0,
            "Ts": 293.0,
            "u_star": 0.35
          },
          "time_span": {"start": 0.0, "end": 1.0},
          "parameter_sweep": {"type": "cartesian", "dimensions": [{"parameter": "season", "values": [1, 2, 3, 4, 5]}]},
          "plots": [
            {
              "id": "v_O3_vs_season",
              "type": "line",
              "description": "v_O3 by season.",
              "x": {"variable": "season", "label": "Wesely season (1 midsummer ... 5 transitional)"},
              "y": {"variable": "v_O3", "label": "v_O3 (m/s)"}
            },
            {
              "id": "v_HNO3_vs_season",
              "type": "line",
